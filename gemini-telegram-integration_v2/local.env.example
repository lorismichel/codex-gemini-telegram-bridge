TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Comma-separated list of allowed chat IDs (DMs and/or group IDs)
TELEGRAM_ALLOWED_CHAT_IDS=YOUR_USER_ID,YOUR_GROUP_ID
# Regex pattern to match mentions in group messages (omit to respond to all group messages)
TELEGRAM_MENTION_PATTERN=(?:^|\s)geminio(?:\s|$|[,.!?])|@your_bot_username
